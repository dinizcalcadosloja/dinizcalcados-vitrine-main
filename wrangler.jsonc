{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anaisa-vitrine-main",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [
    { "pattern": "anaisastore.com.br", "custom_domain": true },
    { "pattern": "www.anaisastore.com.br", "custom_domain": true },
  ],
  "kv_namespaces": [
    {
      "binding": "ANALYTICS_KV",
      "id": "510104b2c00344b0a82d9a71f7f24a33",
      "preview_id": "REPLACE_WITH_YOUR_KV_PREVIEW_NAMESPACE_ID",
    },
  ],
}
